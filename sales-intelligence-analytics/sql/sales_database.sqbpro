-- 1. View the first 10 sales records
SELECT *
FROM sales
LIMIT 10;

-- 2. Calculate total sales, profit and quantity
SELECT
    ROUND(SUM(Sales), 2) AS total_sales,
    ROUND(SUM(Profit), 2) AS total_profit,
    SUM(Quantity) AS total_quantity
FROM sales;

-- 3. Find profit by product category
SELECT
    Category,
    ROUND(SUM(Profit), 2) AS total_profit
FROM sales
GROUP BY Category
ORDER BY total_profit DESC;

-- 4. Find profit by region
SELECT
    Region,
    ROUND(SUM(Profit), 2) AS total_profit
FROM sales
GROUP BY Region
ORDER BY total_profit DESC;

-- 5. Find sales by year
SELECT
    strftime('%Y', Order_Date) AS sales_year,
    ROUND(SUM(Sales), 2) AS total_sales
FROM sales
GROUP BY sales_year
ORDER BY sales_year;

SELECT
    Discount,
    ROUND(SUM(Sales), 2) AS total_sales,
    ROUND(SUM(Profit), 2) AS total_profit,
    ROUND(AVG(Profit), 2) AS average_profit
FROM sales
GROUP BY Discount
ORDER BY Discount;

SELECT
    Product,
    ROUND(SUM(Sales), 2) AS total_sales,
    ROUND(SUM(Profit), 2) AS total_profit
FROM sales
GROUP BY Product
ORDER BY total_profit DESC
LIMIT 10;


-- 7. Monthly sales analysis
SELECT
    strftime('%Y-%m', Order_Date) AS sales_month,
    ROUND(SUM(Sales), 2) AS total_sales,
    ROUND(SUM(Profit), 2) AS total_profit
FROM sales
GROUP BY sales_month
ORDER BY sales_month;

-- 8. Top 10 customers by sales
SELECT
    Customer_ID,
    ROUND(SUM(Sales), 2) AS total_sales,
    ROUND(SUM(Profit), 2) AS total_profit
FROM sales
GROUP BY Customer_ID
ORDER BY total_sales DESC
LIMIT 10;

</sql><current_tab id="0"/></tab_sql></sqlb_project>
